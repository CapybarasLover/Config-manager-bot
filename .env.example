BOT_TOKEN=

# Включённые страны через запятую: latv, germ, pol, fin. Пусто — все настроенные.
# Выключенная страна пропадает из бота целиком (кнопка, статус, синк), записи в БД остаются.
# ENABLED_COUNTRIES=latv,germ,fin

# Германская панель
GERMAN_PANEL_HOME_URL=
# API-токен панели (3x-ui → Settings → Security/API). Authorization: Bearer
XUI_API_TOKEN_GERM=
# База для ссылки подписки (напр. https://bimbambom.site:2096/sub/)
GERM_SUB_BASE_URL=
# ID inbound'ов (по умолчанию WS=3, XHTTP=2; 0 = выключить протокол и убрать его кнопку)
# GERM_WS_INBOUND=3
# GERM_XHTTP_INBOUND=2
# Reality inbound — кнопка «Reality» в выборе типа (входит и в «Все»; по умолчанию 5; 0 = выключить)
# GERM_REALITY_INBOUND=5

# Латвийская панель
LATV_PANEL_HOME_URL=
# API-токен панели (3x-ui → Settings → Security/API). Authorization: Bearer
XUI_API_TOKEN_LATV=
# База для ссылки подписки (по умолчанию https://petromerzlikino.site:2096/sub/)
# LATV_SUB_BASE_URL=
# ID inbound'ов на Latvian панели (по умолчанию WS prod=1/dev=3; 0 = выключить WS).
# LATV_WS_INBOUND_PROD=1
# LATV_WS_INBOUND_DEV=3
# XHTTP на Риге больше нет — LATV_XHTTP_INBOUND_* не используются.
# Reality inbound. Выбора типа на Риге нет, поэтому Reality выдаётся вместе с WS (prod по умолчанию 8; 0 = выключить; в dev по умолчанию выключен)
# LATV_REALITY_INBOUND_PROD=8
# LATV_REALITY_INBOUND_DEV=

# Польская панель (Варшава). Необязательная: пока POL_PANEL_HOME_URL пуст, кнопки «Польша» нет.
POL_PANEL_HOME_URL=
# API-токен панели (3x-ui → Settings → Security/API). Authorization: Bearer
XUI_API_TOKEN_POL=
# База для ссылки подписки (напр. https://host:2096/sub/)
POL_SUB_BASE_URL=
# ID inbound'ов — умолчаний нет; пусто или 0 = inbound не используется, нужен хотя бы один.
# Есть и WS, и XHTTP — пользователь выбирает: WebSocket / xHTTP / Reality (ровно этот протокол) или «Все».
# Иначе тип не спрашивается и выдаются все протоколы панели.
POL_WS_INBOUND=
POL_XHTTP_INBOUND=
POL_REALITY_INBOUND=

# Финская панель. Необязательная: пока FIN_PANEL_HOME_URL пуст, кнопки «Финляндия» нет.
FIN_PANEL_HOME_URL=
# API-токен панели (3x-ui → Settings → Security/API). Authorization: Bearer
XUI_API_TOKEN_FIN=
# База для ссылки подписки (напр. https://host:2096/sub/)
FIN_SUB_BASE_URL=
# ID inbound'ов — умолчаний нет; пусто или 0 = inbound не используется, нужен хотя бы один.
FIN_WS_INBOUND=
FIN_XHTTP_INBOUND=
FIN_REALITY_INBOUND=

# Примечание: vless/xhttp-ссылки теперь генерирует сама панель
# (GET /panel/api/clients/links/{email}), поэтому ручные xHTTP-параметры
# (порты, host, pbk/sni/sid/fp/path/spx) больше не нужны.

DB_LINK_PROD=
DB_LINK_DEV=

DB_USER=
DB_PASSWORD=
DB_NAME=

ADMIN_CHATS=
